# ==========================================
# SADIE AI Personal Assistant Configuration
# ==========================================

# Application Settings
APP_NAME=SADIE
APP_VERSION=1.0.0
DEBUG=True
API_PREFIX=/api

# Server Settings
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./data/sadie.db

# Authentication Security (Change in production!)
JWT_SECRET=super_secret_sadie_jwt_key_change_me_in_production_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration (For Phase 3)
# Supported: gemini, openai, anthropic, ollama
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Tool System Settings
ALLOWED_APPS=calc.exe,notepad.exe,code,chrome
ALLOWED_FOLDERS=Documents,Downloads,Projects,Study Materials
